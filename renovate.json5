{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // THE INSTRUMENT FOR A REPO WHERE ZERO PRs IS THE NORMAL STATE.
  //
  // All six wraps and both container bases sit at their newest upstream
  // version most of the time, so the expected output of a renovate run here is
  // nothing at all. That is the same output a run produces when every manager
  // has silently stopped matching -- a regex that matches nothing, a datasource
  // that rate-limits, a postUpgradeTasks command the host stopped allowing.
  // luka/notes/deferred.md in mksystem names this shape twice over: no PR
  // because nothing is due reads exactly like no PR because it broke.
  //
  // The dashboard is the third state. It renders, in an issue, every dependency
  // renovate is actually tracking and the version it believes each is pinned
  // at, whether or not anything is due -- so "still working" and "stopped
  // looking" stop producing identical evidence. Six wrap rows on that issue is
  // the daily proof that the custom managers below still match; their absence
  // is the alarm.
  //
  // It does NOT prove the wrap-rehash command runs. Nothing short of a real
  // upstream release does -- see the postUpgradeTasks comment below.
  dependencyDashboard: true,

  // Replaces the onboarding renovate.json, which was the bare schema line and
  // nothing else. Both files must never exist at once: renovate refuses a repo
  // carrying two config files.
  //
  // A CUSTOM MANAGER IS NEEDED AT ALL BECAUSE THE BASE IMAGES ARE IN A HEREDOC.
  // sdk-update.yml writes Containerfile.sdk and Containerfile.runtime from a
  // `run:` block, so their `FROM fedora:44` lines are shell string content
  // rather than a Containerfile. No stock manager parses them: the dockerfile
  // manager never sees a file, and the github-actions manager reads
  // `container:` and `uses:`, not the body of a script. Without the first
  // manager below, those two images would be the only unmonitored things in a
  // repo where everything else is tracked -- which reads like coverage.
  //
  // Verified by extraction rather than by validating the syntax, because a
  // regex manager that matches nothing validates exactly like one that works:
  // renovate --platform=local --dry-run=full reports currentValue 44 from
  // sdk-update.yml, twice, once per FROM. Two and not three is itself the
  // check -- this repo declares no `container:` image anywhere, so both
  // findings come from these managers.
  //
  // `managerFilePatterns`, not `fileMatch`. Both are accepted by renovate
  // 44.11.4 (the version mithos runs) but fileMatch emits `WARN: Config
  // migration necessary` and is rewritten to this, /.../ wrapper included. The
  // patterns cover all workflow files rather than sdk-update.yml alone:
  // narrower is tighter today and silently stops monitoring the day the file
  // is renamed.
  customManagers: [
    // Anchored to end of line. Unanchored, these also match PROSE -- a
    // comment mentioning `image: fedora:44` in a sibling repo captured the
    // trailing backtick as part of the version and produced a phantom
    // dependency renovate then offered to "update". Caught by checking at the
    // CURRENT pin, where the right answer is zero, not just at an old one.
    //
    // Every FROM, by docker tag. This is the general case and stays -- a
    // future `FROM alpine:3.x` here should be tracked normally. fedora is
    // carved out of it by the packageRule below and handled by the manager
    // after this one.
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.forgejo/workflows/.+\\.ya?ml$/'],
      matchStrings: ['FROM (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)\\s*\\n'],
      datasourceTemplate: 'docker',
    },
    // FEDORA, BY RELEASE RATHER THAN BY TAG. `fedora:45` exists on Docker Hub
    // today and is not Fedora 45: measured 2026-08-04, its manifest is
    // byte-identical to fedora:rawhide, while fedora:latest is byte-identical
    // to fedora:44. endoflife.date lists only RELEASED cycles -- newest fedora
    // entry is 44, releaseDate 2026-04-28, eol 2027-06-02, and 45 is absent --
    // so "is it listed" is "has it shipped". No date arithmetic, no manual pin
    // to lift, and the PR arrives on release day by itself.
    //
    // This matches the same lines as the manager above, so fedora is extracted
    // twice, once per datasource. That is why the packageRule is not optional:
    // without it the docker half still proposes 45.
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.forgejo/workflows/.+\\.ya?ml$/'],
      matchStrings: ['FROM fedora:(?<currentValue>[0-9]+)\\s*\\n'],
      depNameTemplate: 'fedora',
      datasourceTemplate: 'endoflife-date',
    },
    // MESON WRAPS. Renovate ships no meson manager -- checked against the
    // supported-manager list, which has gradle-wrapper and maven-wrapper and
    // nothing for meson -- so the wraps would otherwise be invisible. Until
    // now only dpp was covered, by a manager whose own comment conceded it was
    // notification-only because renovate cannot compute a sha256.
    //
    // Six wraps, not seven: subprojects/peel.wrap went with this change. It
    // was `revision = HEAD, depth=1` and nothing in the build referenced it --
    // src/vocadb/meson.build's build_anidb_sourcegen branch uses cpr, libmagic
    // and nlohmann_json, never peel -- so there was no version to track and
    // nothing consuming it.
    //
    // It still cannot. What changed is postUpgradeTasks below: the managers
    // here bump the version inside source_url and nothing else, and
    // tools/wrap-rehash.sh finishes the file -- source_filename, directory,
    // source_hash, and the version inside the source_url FILENAME. That
    // division is forced, not chosen: renovate's autoReplace rewrites only the
    // span a matchString matched, so the rest is unreachable from here no
    // matter how the regex is written.
    //
    // The source_url filename is the non-obvious one and the reason a
    // "notification only" manager was never enough on its own. These managers
    // match the `/v<ver>/` PATH COMPONENT, so on dpp -- whose asset name also
    // carries the version -- renovate produces
    // `.../download/v10.1.7/DPP-10.1.6.tar.gz`, which 404s. Measured, not
    // reasoned about: the script's own download step is what surfaced it.
    //
    // depName comes out of the URL rather than a depNameTemplate, which is
    // what lets one manager cover three wraps. Safe here and NOT safe in the
    // FROM managers above: managerFilePatterns confines these to
    // subprojects/*.wrap, where there is no prose for an unanchored pattern to
    // match. currentValue deliberately excludes the leading `v` so that it
    // lines up with what extractVersionTemplate produces.
    //
    // Verified by extraction and not by validating the syntax, for the same
    // reason as the managers above -- renovate --platform=local --dry-run=full
    // at LOG_LEVEL=debug reports exactly six wrap deps and the version each
    // wrap is actually pinned to:
    //   brainboxdotcc/DPP      10.1.6  github-releases
    //   nlohmann/json          3.12.0  github-releases
    //   jupp0r/prometheus-cpp   1.3.0  github-releases
    //   Neargye/magic_enum      0.9.8  github-tags
    //   uni-algo/uni-algo       1.2.0  github-tags
    //   boost-ext/ut            2.3.1  github-tags
    // and, rolled back to uni-algo 1.1.0, proposes 1.2.0 rather than nothing.
    //
    // RELEASE TARBALLS: dpp, json, prometheus-cpp.
    {
      customType: 'regex',
      managerFilePatterns: ['/^subprojects/.+\\.wrap$/'],
      matchStrings: ['source_url\\s*=\\s*https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v(?<currentValue>[0-9][^/\\s]*)/'],
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    // TAG TARBALLS: magic_enum, uni-algo. github-tags and not github-releases:
    // archive/refs/tags resolves for every tag whether or not a release was
    // ever cut, so keying these to releases would make coverage depend on an
    // upstream habit rather than on the thing the URL actually names.
    {
      customType: 'regex',
      managerFilePatterns: ['/^subprojects/.+\\.wrap$/'],
      matchStrings: ['source_url\\s*=\\s*https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/archive/refs/tags/v(?<currentValue>[0-9][^/\\s]*)\\.tar\\.'],
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    // WRAP-GIT PINNED TO A TAG: boostut. No tarball and so no hash, which
    // makes this the one wrap renovate can finish by itself -- wrap-rehash.sh
    // skips it.
    {
      customType: 'regex',
      managerFilePatterns: ['/^subprojects/.+\\.wrap$/'],
      matchStrings: ['url\\s*=\\s*https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+?)(?:\\.git)?\\s*\\nrevision\\s*=\\s*v(?<currentValue>[0-9][^\\s]*)'],
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],

  // THE HALF THE REGEX MANAGERS CANNOT DO. Without this a wrap PR carries a
  // source_hash for the PREVIOUS tarball, and meson refuses at `setup` before
  // a line compiles -- which is worse than no coverage, because it arrives
  // looking like a normal PR.
  //
  // AND IT STILL ARRIVES IF THE SCRIPT FAILS. Read renovate's
  // execute-post-upgrade-commands.js rather than assuming: a command that
  // throws is caught into artifactErrors and the PR is opened anyway, with a
  // warning in its body and the old hash still in the wrap. Nothing here
  // abandons a branch. pr-build.yml is what turns that into a red check
  // instead of a merge.
  //
  // The command is a single argv with no shell metacharacters, so mithos needs
  // only `allowedCommands: ['^tools/wrap-rehash\\.sh$']`;
  // allowShellExecutorForPostUpgradeCommands stays false and
  // allowPostUpgradeCommandTemplating is not needed. The script needs outbound
  // github.com from the renovate host -- it re-downloads each tarball to hash
  // it -- and exits non-zero on any failure so the branch is abandoned rather
  // than published wrong.
  //
  // executionMode 'branch' and not 'update': the script reconciles the whole
  // subprojects/ directory in one pass and is idempotent, so running it once
  // per branch is both sufficient and cheaper than once per dependency.
  postUpgradeTasks: {
    commands: ['tools/wrap-rehash.sh'],
    fileFilters: ['subprojects/*.wrap'],
    executionMode: 'branch',
  },

  // Verified in both directions, because "everything disabled" and "working
  // correctly" both report zero updates at fedora:44:
  //   fedora:44 -> 0 updates
  //   fedora:41 -> proposes 44, never 45
  //
  // Cost: nothing about the fedora IMAGE is tracked any more, digest
  // refreshes included -- only its cycle number -- and this leans on
  // endoflife.date being current. The failure mode is a late PR, never an
  // early one. Non-fedora images are unaffected and still tracked by digest
  // and tag.
  //
  // WHEN THE PR ARRIVES it is heavier here than in fedora-emacs or ppgen:
  // songbot-runtime is deployed on 39music, so merging changes a running
  // service on another host rather than a CI job. songbot-sdk is only a build
  // environment and is the cheap half of the same PR.
  packageRules: [
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['fedora'],
      enabled: false,
    },
  ],
}
