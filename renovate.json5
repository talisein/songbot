{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Replaces the onboarding renovate.json, which was the bare schema line and
  // nothing else. Both files must never exist at once: renovate refuses a repo
  // with two config files, so the old one is deleted in the same commit.
  //
  // THE CUSTOM MANAGER EXISTS BECAUSE THE BASE IMAGES ARE INSIDE A HEREDOC.
  // sdk-update.yml writes Containerfile.sdk and Containerfile.runtime from a
  // `run:` block, so their `FROM fedora:44` lines are shell string content,
  // not a Containerfile. No stock manager parses them: the dockerfile manager
  // never sees a file, and the github-actions manager reads `container:` and
  // `uses:`, not the body of a script. Without this block those two images
  // would be the only unmonitored things in the repo while everything around
  // them was tracked -- which reads like coverage.
  //
  // Verified by extraction on 2026-08-04, not by validating the syntax:
  // `renovate --platform=local --dry-run=full` reports depName `fedora`,
  // currentValue `44`, from .forgejo/workflows/sdk-update.yml, twice -- once
  // per FROM. A regex manager that matches nothing validates exactly like one
  // that works, so the count is the check.
  //
  // The pattern covers ALL workflow files rather than sdk-update.yml alone.
  // Narrower would be tighter today and would silently stop monitoring the
  // day the file is renamed. The cost is that a stray `FROM` in any workflow
  // becomes a dependency; there is none today, and one appearing is visible
  // as a new PR rather than as silence.
  customManagers: [
    {
      customType: 'regex',
      // `managerFilePatterns`, not `fileMatch`. Both are accepted by renovate
      // 44.11.4 (the version the mithos container runs), but fileMatch emits
      // `WARN: Config migration necessary` and is rewritten to this anyway.
      // Note the /.../ wrapper -- that is part of the newer syntax.
      managerFilePatterns: ['/^\\.forgejo/workflows/.+\\.ya?ml$/'],
      matchStrings: ['FROM (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)'],
      datasourceTemplate: 'docker',
    },
  ],

  // MAJOR UPDATES OFF for fedora, same rule as fedora-emacs and ppgen, and
  // here it applies to both the job containers and the two heredoc FROMs
  // above. A fedora:45 base is a deliberate decision about what songbot-sdk
  // and songbot-runtime are built against -- and songbot-runtime is deployed
  // on 39music, so the blast radius of an automatic major bump is a running
  // service on another host, not a CI job.
  //
  // fedora:45 is already published, so this is load-bearing now. Measured
  // 2026-08-04 against this repo: without the rule, 2 flattened updates on
  // `renovate/fedora-45`; with it, 0. Two and not three -- this repo has no
  // `container:` image anywhere, so both come from the custom manager above,
  // which is also the check that it is finding them.
  packageRules: [
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['fedora'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
}
