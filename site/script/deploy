#!/usr/bin/env bash
# Publish the built site in public/ to a static host.
#
# The build (songbot-export-json) knows nothing about where the site is
# hosted; this script is the only place that does. To move hosts, add a case
# below, set DEPLOY_TARGET in .forgejo/workflows/publish-data.yml, and swap
# the secrets. Run from site/.
#
#   BRANCH   git branch being deployed (production branch goes live,
#            anything else becomes a preview where the host supports it)
#   COMMIT   commit hash, for the host's deployment log
set -euo pipefail

: "${DEPLOY_TARGET:=cloudflare-workers}"
: "${BRANCH:?}"
: "${COMMIT:=unknown}"

[ -d public ] || { echo "public/ missing; run songbot-export-json first" >&2; exit 1; }

case "$DEPLOY_TARGET" in
  cloudflare-workers)
    # Assets-only Worker described by wrangler.jsonc. Needs
    # CLOUDFLARE_API_TOKEN (Workers > Individual Workers > <name> > Editor) and
    # CLOUDFLARE_ACCOUNT_ID; <name> below is the Worker name in wrangler.jsonc.
    : "${CLOUDFLARE_API_TOKEN:?}" "${CLOUDFLARE_ACCOUNT_ID:?}"
    if [ "$BRANCH" = main ]; then
      exec npx --yes wrangler@4 deploy --message="$COMMIT"
    fi
    # Other branches: upload a version without promoting it, reachable at
    # <alias>-<name>.<subdomain>.workers.dev. Aliases are DNS labels.
    alias=$(printf '%s' "$BRANCH" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//' | cut -c1-40)
    exec npx --yes wrangler@4 versions upload --preview-alias="$alias" --message="$COMMIT"
    ;;
  # rsync)
  #   [ "$BRANCH" = main ] || { echo "no previews for rsync; skipping"; exit 0; }
  #   exec rsync -rlz --delete public/ "$RSYNC_DEST"
  #   ;;
  *)
    echo "unknown DEPLOY_TARGET: $DEPLOY_TARGET" >&2
    exit 1
    ;;
esac
